# ==============================================================================
# SupportBrain Environment Variables
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Groq API Configuration
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Hindsight Memory System Configuration
# Option A: Hindsight Cloud (https://hindsight.vectorize.io)
# HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
# HINDSIGHT_API_KEY=your_hindsight_api_key_here
#
# Option B: Local Hindsight Instance (or embedded local service)
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=

# Local Development / Demo Mode Toggle
# When true and Hindsight cloud/docker is not reachable, uses local Hindsight HTTP service on port 8888
HINDSIGHT_AUTO_START_LOCAL=true
