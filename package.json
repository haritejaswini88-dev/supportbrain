{
  "name": "supportbrain-monorepo",
  "version": "1.0.0",
  "description": "SupportBrain — AI Customer Support Agent with Persistent Hindsight Memory",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server test",
    "build": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "supportbrain",
    "hindsight",
    "groq",
    "ai-agent",
    "customer-support"
  ],
  "author": "",
  "license": "MIT"
}
